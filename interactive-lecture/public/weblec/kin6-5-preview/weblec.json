     "h": 130,
     "tex": "W=\\\\dfrac{Q^{2}}{2C}",
     "size": 40,
     "color": "#C00000",
     "align": "center",
     "hotspot": true,
     "label": "电容储能公式一",
     "qa": [
      {
       "q": "这个式子里的 Q 指什么？",
       "a": "指电容器极板所带电荷量，由 $Q=CU$ 与电压关联。"
      }
     ]
    },
    {
     "type": "tex",
     "step": 2,
     "x": 170,
     "y": 420,
     "w": 1580,
     "h": 130,
     "tex": "W=\\\\dfrac{1}{2}QU",
     "size": 40,
     "color": "#C00000",
     "align": "center",
