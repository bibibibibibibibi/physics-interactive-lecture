[{"start": 0.0, "end": 1.87, "text": "小结。"}, {"start": 2.27, "end": 7.53, "text": "德布罗意假设：实物粒子的波长 λ 等于 h 比 p。"}, {"start": 7.93, "end": 16.47, "text": "两个计算：电子在 100 电子伏特下波长 0.123 纳米；由驻波条件能推出玻尔的量子条件。"}, {"start": 16.87, "end": 23.23, "text": "实验：戴维孙-革末和汤姆孙的电子衍射，直接证实了物质波。"}, {"start": 23.63, "end": 26.8, "text": "应用：电镜和 STM。"}, {"start": 27.2, "end": 30.22, "text": "理解：物质波是概率波。"}, {"start": 30.62, "end": 33.19, "text": "下一节讲不确定关系。"}]