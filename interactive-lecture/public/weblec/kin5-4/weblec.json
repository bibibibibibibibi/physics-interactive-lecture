     "w": 780,
     "h": 52,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "斯托克斯定律：$F_r=6\\pi\\eta rv$",
        "size": 32,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 3,
     "x": 170,
     "y": 460,
     "w": 780,
     "h": 52,
     "align": "left",
     "valign": "center",
     "paras": [
