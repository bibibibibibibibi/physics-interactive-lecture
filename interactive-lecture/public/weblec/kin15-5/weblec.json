     "w": 1580,
     "h": 44,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "关键在「够不够」—— 不是多少，而是到没到门槛",
        "size": 26,
        "color": "#0000CD",
        "b": true
       }
      ]
     ]
    },
