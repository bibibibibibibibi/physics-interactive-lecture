     "step": 2,
     "x": 170,
     "y": 380,
     "w": 1580,
     "h": 140,
     "tex": "w=\\\\dfrac{1}{2}\\\\varepsilon_0\\\\varepsilon_r E^{2}=\\\\dfrac{Q^{2}}{32\\\\pi^{2}\\\\varepsilon_0\\\\varepsilon_r r^{4}}",
