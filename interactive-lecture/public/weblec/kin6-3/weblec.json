        "t": "$D$ 的表达式与真空中",
        "size": 31,
        "color": "#111111",
        "b": false
       },
       {
        "t": "完全一样",
        "size": 31,
        "color": "#C00000",
        "b": true
       },
       {
        "t": "；$E$ 多除一个 $\\varepsilon_r$．",
        "size": 31,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
