     "tex": "\\begin{cases}(F_{\\mathrm{T}}+\\mathrm{d}F_{\\mathrm{T}})\\cos\\dfrac{\\mathrm{d}\\theta}{2}-F_{\\mathrm{T}}\\cos\\dfrac{\\mathrm{d}\\theta}{2}-F_{\\mathrm{f}}=0\\\\[20px]-(F_{\\mathrm{T}}+\\mathrm{d}F_{\\mathrm{T}})\\sin\\dfrac{\\mathrm{d}\\theta}{2}-F_{\\mathrm{T}}\\sin\\dfrac{\\mathrm{d}\\theta}{2}+F_{\\mathrm{N}}=0\\end{cases}",
