[{"start": 0.0, "end": 2.57, "text": "电势差有多大量级？"}, {"start": 3.22, "end": 5.12, "text": "看这张表。"}, {"start": 5.52, "end": 10.01, "text": "生物电只有毫伏量级，十的负三次方伏。"}, {"start": 10.41, "end": 14.87, "text": "普通干电池一点五伏，汽车电瓶十二伏。"}, {"start": 15.27, "end": 18.97, "text": "家用电器一百一十或二百二十伏。"}, {"start": 19.37, "end": 25.3, "text": "高压输电线可以达到五点五乘十的五次方伏，也就是五十五万伏。"}, {"start": 25.7, "end": 31.96, "text": "而闪电，是十的八次方到十的九次方伏——差了好几个数量级。"}, {"start": 32.36, "end": 38.31, "text": "这也说明，电势差本身没有「危险不危险」，要看能量和电流。"}]