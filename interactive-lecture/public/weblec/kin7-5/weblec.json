    {
     "type": "text",
     "step": 0,
     "x": 170,
     "y": 137,
     "w": 1200,
     "h": 90,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "二　磁场中的圆周运动",
        "size": 48,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
