     "step": 5,
     "x": 1010,
     "y": 600,
     "w": 700,
     "h": 150,
     "tex": "AD=AC\\sin i=2d\\tan\\gamma\\sin i",
     "size": 34,
     "color": "#0000CD",
     "align": "left"
    },
    {
     "type": "text",
     "step": 6,
     "x": 170,
     "y": 790,
     "w": 1580,
     "h": 80,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "λ/2 来自 A 点反射的半波损失（n₂ ＞ n₁ 时）．",
        "size": 31,
        "color": "#444",
        "b": false
       }
      ]
