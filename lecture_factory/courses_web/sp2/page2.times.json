[
 {
  "start": 0.0,
  "end": 2.181,
  "text": "我们的学习分四段。"
 },
 {
  "start": 2.581,
  "end": 10.005,
  "text": "第一段，电磁感应现象，比较改变磁场、改变回路面积时的实验结果，找出共同条件。"
 },
 {
  "start": 10.405,
  "end": 12.452,
  "text": "这是本课的重点。"
 },
 {
  "start": 12.852,
  "end": 17.7,
  "text": "第二段，法拉第定律，把变化快慢写成可以计算的公式。"
 },
 {
  "start": 18.099,
  "end": 25.392,
  "text": "第三段，楞次定律，把公式里的负号翻译成电流方向，这是本课的重点和难点。"
 },
 {
  "start": 25.792,
  "end": 32.773,
  "text": "第四段，应用与迁移，用铜管实验和无线充电检验我们是否真正理解了规律。"
 },
 {
  "start": 33.173,
  "end": 37.509,
  "text": "每遇到一道随堂题，先独立选择，再看解析。"
 }
]
