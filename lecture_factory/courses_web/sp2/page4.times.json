[
 {
  "start": 0.0,
  "end": 3.534,
  "text": "我们已经知道，电流能够激发磁场。"
 },
 {
  "start": 3.934,
  "end": 7.468,
  "text": "反过来，磁场能不能产生电流？"
 },
 {
  "start": 8.118,
  "end": 13.267,
  "text": "敢于这样追问，是探索的起点；答案还要交给实验。"
 },
 {
  "start": 13.667,
  "end": 17.385,
  "text": "一八三一年，法拉第发现电磁感应。"
 },
 {
  "start": 17.785,
  "end": 24.227,
  "text": "请看他的肖像与实验日记，科学发现需要把细微现象认真记录下来。"
 },
 {
  "start": 24.627,
  "end": 29.499,
  "text": "两个彼此绝缘的线圈，一个接电源，一个接检流计。"
 },
 {
  "start": 29.899,
  "end": 35.325,
  "text": "第一个线圈保持稳定电流，第二个线圈却没有持续电流。"
 },
 {
  "start": 35.725,
  "end": 39.605,
  "text": "看似“没有反应”的结果，也是一条重要证据！"
 },
 {
  "start": 40.255,
  "end": 44.458,
  "text": "在接通或断开的过程中，指针反而会偏转。"
 },
 {
  "start": 44.858,
  "end": 47.099,
  "text": "差别究竟在哪里？"
 },
 {
  "start": 47.749,
  "end": 50.706,
  "text": "下一页，我们亲手比较。"
 },
 {
  "start": 51.106,
  "end": 56.762,
  "text": "请带着这样的态度观察：尊重事实，让证据修正猜想。"
 }
]
