[{"start": 0.0, "end": 3.86, "text": "要描述运动，先解决两个预备概念。"}, {"start": 4.26, "end": 6.61, "text": "第一个，参考系。"}, {"start": 7.01, "end": 11.64, "text": "为描述物体运动而选的标准物，就叫参考系。"}, {"start": 12.04, "end": 14.15, "text": "第二个，质点。"}, {"start": 14.55, "end": 19.04, "text": "想一想，什么时候能把一个物体看成一个点？"}, {"start": 19.69, "end": 27.13, "text": "当物体的大小和形状的变化，对它的运动影响可以忽略时，我们就把物体当成一个有质量的点。"}, {"start": 27.53, "end": 30.96, "text": "所以，质点是一个理想模型。"}]