     "step": 1,
     "x": 985,
     "y": 250,
     "w": 765,
     "h": 372,
     "name": "bit_choice"
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 236,
     "w": 740,
     "h": 48,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "两种可能，选一个 = 1 bit",
        "size": 29,
        "color": "#0000CD",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "text",
