[
 {
  "start": 0.0,
  "end": 2.759,
  "text": "先看这个可以操作的实验台。"
 },
 {
  "start": 3.159,
  "end": 11.429,
  "text": "左边调节开关和参数，中间两个回路彼此绝缘，右边上图记录磁通量，下图记录感应电动势。"
 },
 {
  "start": 11.829,
  "end": 15.721,
  "text": "检流计接在感应回路里，没有接到励磁电源。"
 },
 {
  "start": 16.121,
  "end": 20.834,
  "text": "开关闭合以后，指针会一直偏转，还是只动一下？"
 },
 {
  "start": 21.484,
  "end": 23.221,
  "text": "先作预测。"
 },
 {
  "start": 23.621,
  "end": 26.446,
  "text": "注意看，现在闭合开关！"
 },
 {
  "start": 27.096,
  "end": 30.522,
  "text": "指针偏转，随后向零回落。"
 },
 {
  "start": 30.922,
  "end": 34.124,
  "text": "再断开，指针向反方向偏转。"
 },
 {
  "start": 34.525,
  "end": 39.617,
  "text": "把这两次短暂偏转，与右边曲线的上升和下降对应起来。"
 },
 {
  "start": 40.017,
  "end": 50.51,
  "text": "关键找到了：在这组位置固定的线圈中，励磁电流建立或减弱时，才有感应响应；稳定以后，磁通量不变，电动势趋近零。"
 },
 {
  "start": 50.91,
  "end": 54.358,
  "text": "模拟把开关过渡放慢，便于观察。"
 },
 {
  "start": 54.758,
  "end": 62.383,
  "text": "你可以暂停，亲手重做一次，再改变感应回路电阻：同样的电动势，为什么电流会不同？"
 }
