     "step": 1,
     "x": 170,
     "y": 236,
     "w": 1580,
     "h": 180,
     "tex": "p=\\frac{m_0v}{\\left(1-\\dfrac{v^2}{c^2}\\right)^{1/2}}=mv",
     "size": 34,
     "color": "#111111",
     "align": "center"
    },
    {
     "type": "text",
     "step": 2,
