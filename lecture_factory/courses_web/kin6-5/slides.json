     "x": 170,
     "y": 137,
     "w": 1580,
     "h": 90,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "能量密度",
        "size": 48,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
