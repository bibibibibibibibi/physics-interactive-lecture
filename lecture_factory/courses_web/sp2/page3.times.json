[
 {
  "start": 0.0,
  "end": 2.654,
  "text": "先看列车缓缓进站。"
 },
 {
  "start": 3.054,
  "end": 6.349,
  "text": "速度降下来了，动能去了哪里？"
 },
 {
  "start": 6.999,
  "end": 12.374,
  "text": "先记住这个能量问题，具体车辆可以采用多种制动方式。"
 },
 {
  "start": 12.774,
  "end": 19.794,
  "text": "再看右边的两根管子：同一块磁铁，在塑料管里很快落下，在铜管里却慢了下来。"
 },
 {
  "start": 20.194,
  "end": 25.843,
  "text": "铜并不像铁那样明显吸引磁铁，这只看不见的“手”从哪里来？"
 },
 {
  "start": 26.493,
  "end": 31.868,
  "text": "还有手机无线充电：导线没有接到手机，电能怎样跨过间隙？"
 },
 {
  "start": 32.518,
  "end": 38.807,
  "text": "一个在减速，一个在传能，看起来相隔很远，会不会藏着同一条规律？"
 },
 {
  "start": 39.457,
  "end": 42.659,
  "text": "想一想，先把你的猜测记下来。"
 },
 {
  "start": 43.059,
  "end": 46.697,
  "text": "接下来，我们用实验一层层揭开答案。"
 }
