     "x": 170,
     "y": 578,
     "w": 1580,
     "h": 140,
     "tex": "\\\\vec D=\\\\varepsilon_0\\\\varepsilon_r\\\\vec E=\\\\varepsilon\\\\vec E",
     "size": 36,
     "color": "#0000CD",
     "align": "center",
     "hotspot": true,
     "label": "线性介质 D-E 关系",
     "qa": [
