        "size": 33,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 2,
     "x": 170,
     "y": 320,
     "w": 1580,
     "h": 52,
     "align": "left",
     "valign": "center",
