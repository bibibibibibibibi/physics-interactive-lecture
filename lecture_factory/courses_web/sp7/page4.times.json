[
 {
  "start": 0.0,
  "end": 4.376,
  "text": "安德鲁斯研究二氧化碳的等温压缩。"
 },
 {
  "start": 4.776,
  "end": 13.39,
  "text": "这里用本地模型演示实验思路：左边是一定量物质的气缸，右边记录压强与摩尔体积。"
 },
 {
  "start": 13.79,
  "end": 20.565,
  "text": "实验要保持温度不变，缓慢移动活塞，使状态接近平衡。"
 },
 {
  "start": 20.965,
  "end": 23.661,
  "text": "现在看自动压缩。"
 },
 {
  "start": 24.061,
  "end": 27.823,
  "text": "起初体积减小、压强升高。"
 },
 {
  "start": 28.223,
  "end": 33.986,
  "text": "进入一段区间后，液体逐渐增多，压强却不变。"
 },
 {
  "start": 34.386,
  "end": 39.722,
  "text": "全部液化后，少量压缩又使压强明显升高。"
 },
 {
  "start": 40.122,
  "end": 43.829,
  "text": "三个阶段出现在同一温度下。"
 },
 {
  "start": 44.229,
  "end": 51.059,
  "text": "模型用临界量作单位，是无量纲示意，不是原实验的测量值。"
 },
 {
  "start": 51.459,
  "end": 57.38,
  "text": "暂停后可拖动体积滑块，比较状态和两相比例。"
 }
]
