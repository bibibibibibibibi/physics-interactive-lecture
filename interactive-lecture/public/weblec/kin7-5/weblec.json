     "w": 740,
     "h": 48,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "$\\vec v\\perp\\vec B$ 时：磁场力充当向心力．",
        "size": 30,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 2,
     "x": 170,
