[
 {
  "start": 0.0,
  "end": 2.508,
  "text": "回到理想模型。"
 },
 {
  "start": 2.908,
  "end": 7.363,
  "text": "先做探究：它省略了分子的哪些特征？"
 },
 {
  "start": 8.013,
  "end": 12.121,
  "text": "主要是分子有限体积与相互作用。"
 },
 {
  "start": 12.521,
  "end": 18.336,
  "text": "在较稀薄的高温低压气态，这两个近似常常有用。"
 },
 {
  "start": 18.736,
  "end": 26.177,
  "text": "现在冷却并压缩一份气体，请做一道选择题，判断哪些假设需要重查。"
 },
 {
  "start": 27.677,
  "end": 35.199,
  "text": "降低温度，吸引作用相对更重要；提高密度，分子占据的空间不能忽略。"
 },
 {
  "start": 35.599,
  "end": 44.561,
  "text": "这就是适用边界：理想方程可以描述一定范围的气态，却没有包含液化与两相共存的机制。"
 },
 {
  "start": 44.961,
  "end": 49.522,
  "text": "模型是否有效，仍要由实验判断。"
 }
]
