# 依赖与构建产物
node_modules/
.venv/
.local-backups/
interactive-lecture/dist-slides/
__pycache__/
*.pyc

# 部署与静态导出通过 Release ZIP 分发；本地文件保留，不重复提交到源码仓库。
interactive-lecture/dist/
interactive-lecture/slides-export/

# 可恢复的制作输入：本地保留页音频和源 PPT 提取材料，元数据仍入库。
lecture_factory/courses_web/*/audio/*.mp3
lecture_factory/courses_web/*/source/**
!lecture_factory/courses_web/*/source/**/
!lecture_factory/courses_web/*/source/**/*.json
!lecture_factory/courses_web/*/source/**/*.html
!lecture_factory/courses_web/*/source/**/*.svg

# 历史审阅版本只保留轻量兼容入口，不再次打包整课媒体。
interactive-lecture/public/weblec/*-review/*
!interactive-lecture/public/weblec/*-review/slides-preview.html

# sp1 已由两个 native 视频替代的旧剪辑；创作原件留在课程 assets/。
interactive-lecture/public/weblec/sp1/snowboard.mp4
interactive-lecture/public/weblec/sp1/BV16Z4y1F7Gm_merged.mp4
interactive-lecture/public/weblec/sp1/station_flight_30s.mp4
interactive-lecture/public/weblec/sp1/BV1VF411E7h7_merged.mp4
interactive-lecture/public/weblec/sp1/BV11c411S7a2_merged.mp4

# 密钥（绝不入库）
.env
.env.local
.env.minimax.local
interactive-lecture/.env.local

# 归档与临时
work/
待处理/
docs/qa/
*.log

# 工具二进制（安装见 README「环境准备」）
tools/tectonic.exe
tools/tectonic
tools/*.zip

# 系统杂项
Thumbs.db
.DS_Store

# FFmpeg合并清单/静音垫为可再生成中间文件；页音频和时间轴继续保留
lecture_factory/courses_web/*/audio/_list*.txt
lecture_factory/courses_web/*/audio/_sil*.mp3
