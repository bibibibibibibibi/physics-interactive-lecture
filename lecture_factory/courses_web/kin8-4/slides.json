    {
     "type": "text",
     "step": 0,
     "x": 170,
     "y": 137,
     "w": 1580,
     "h": 90,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "三　磁能密度",
        "size": 50,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "diagram",
     "step": 1,
     "x": 985,
     "y": 240,
     "w": 765,
     "h": 470,
     "name": "mag_energy_vol"
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 236,
     "w": 740,
     "h": 48,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "换一个角度：不看线圈，只看磁场",
        "size": 31,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 2,
     "x": 170,
     "y": 300,
     "w": 740,
     "h": 48,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "螺线管：$L=\\mu_0n^{2}V$，$B=\\mu_0ni$",
        "size": 30,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 3,
     "x": 170,
     "y": 366,
     "w": 730,
     "h": 120,
     "tex": "W_m=\\frac12LI^{2}=\\frac12\\mu_0n^{2}V\\!\\left(\\frac{B}{\\mu_0n}\\right)^{2}",
     "size": 26,
     "color": "#111111",
     "align": "left"
    },
    {
     "type": "tex",
     "step": 4,
     "x": 170,
     "y": 510,
     "w": 730,
     "h": 120,
     "tex": "W_m=\\frac{B^{2}}{2\\mu_0}V",
     "size": 32,
     "color": "#C00000",
     "align": "left"
    },
    {
