[{"start": 0.0, "end": 3.36, "text": "大家好，这一节我们讲简谐振动。"}, {"start": 3.76, "end": 6.04, "text": "先说什么是机械振动。"}, {"start": 6.44, "end": 12.92, "text": "物体或者物体的一部分，在某个位置附近来回往复的运动，就叫机械振动。"}, {"start": 13.32, "end": 17.09, "text": "这个位置有个专门的名字，叫平衡位置。"}, {"start": 17.49, "end": 19.65, "text": "生活里到处都是例子。"}, {"start": 20.05, "end": 25.11, "text": "心脏的跳动、钟摆的摆动、乐器发声，甚至地震。"}, {"start": 25.51, "end": 27.53, "text": "这些都是机械振动。"}]