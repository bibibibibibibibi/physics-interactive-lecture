[
 {
  "start": 0.0,
  "end": 2.647,
  "text": "再来解开无线充电的悬念。"
 },
 {
  "start": 3.047,
  "end": 7.428,
  "text": "请沿着图从左向右，把能量传递链亲口说出来。"
 },
 {
  "start": 7.828,
  "end": 14.697,
  "text": "发射线圈中有交变电流，产生变化磁场，其中一部分穿过接收线圈。"
 },
 {
  "start": 15.097,
  "end": 19.768,
  "text": "于是接收线圈的磁通量变化，产生感应电动势。"
 },
 {
  "start": 20.168,
  "end": 23.772,
  "text": "电能跨过了间隙，靠的是磁场耦合。"
 },
 {
  "start": 24.172,
  "end": 27.863,
  "text": "到这里，手机电池就能直接充电了吗？"
 },
 {
  "start": 28.513,
  "end": 37.027,
  "text": "还差关键一步：接收线圈产生交变电信号，需要经过整流、稳压和充电管理，才能送入电池。"
 },
 {
  "start": 37.427,
  "end": 40.141,
  "text": "电源始终是能量的来源。"
 },
 {
  "start": 40.541,
  "end": 44.232,
  "text": "这条链少讲一步，工程解释就不完整。"
 },
 {
  "start": 44.632,
  "end": 46.835,
  "text": "线圈为什么要对准？"
 },
 {
  "start": 47.485,
  "end": 51.266,
  "text": "位置影响耦合，也影响有效能量传递。"
 },
 {
  "start": 51.666,
  "end": 59.536,
  "text": "从“能不能充电”继续追问到“怎样高效、可靠地充电”，正是把物理规律变成有用技术时应有的责任。"
 }
]
