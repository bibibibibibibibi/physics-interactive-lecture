[
 {
  "start": 0.0,
  "end": 2.203,
  "text": "现在回答开头的问题。"
 },
 {
  "start": 2.603,
  "end": 4.787,
  "text": "光子为什么波长变长？"
 },
 {
  "start": 5.437,
  "end": 11.662,
  "text": "在近似自由、初始静止电子的模型中，它把能量和动量交给反冲电子。"
 },
 {
  "start": 12.062,
  "end": 14.944,
  "text": "两条守恒律共同给出位移规律。"
 },
 {
  "start": 15.344,
  "end": 21.388,
  "text": "未位移峰来自束缚电子和原子整体的相干响应，反冲位移小到难以分辨。"
 },
 {
  "start": 21.788,
  "end": 23.951,
  "text": "两类贡献可以并存。"
 },
 {
  "start": 24.351,
  "end": 30.995,
  "text": "电子质量相同，所以材料不同仍有相同的电子位移规律，但峰强与束缚响应可以不同。"
 },
 {
  "start": 31.395,
  "end": 39.157,
  "text": "能量和事件顺序可确定时，能量损失帮助重建极角西塔；许多双击中事件的连线方位斐用于统计偏振。"
 },
 {
  "start": 39.557,
  "end": 42.922,
  "text": "一个事件不能给出整个伽马暴的偏振度。"
 },
 {
  "start": 43.322,
  "end": 47.947,
  "text": "最后，要区分理论预测、教学示意和原始数据。"
 },
 {
  "start": 48.347,
  "end": 55.97,
  "text": "模型提出可检验的预言，实验检验它的适用边界；这条研究路径贯穿历史实验与现代偏振探测。"
 }
]
