    },
    {
     "type": "tex",
     "step": 5,
     "x": 240,
     "y": 566,
     "w": 1440,
     "h": 120,
     "tex": "\\vec B=\\mu_0(\\vec H+\\vec M)",
     "size": 36,
     "color": "#0000CD",
     "align": "left"
    },
    {
     "type": "text",
     "step": 6,
     "x": 170,
     "y": 706,
