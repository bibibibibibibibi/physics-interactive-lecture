[
 {
  "start": 0.0,
  "end": 3.816,
  "text": "再用一道题检查你是否真的会减法。"
 },
 {
  "start": 4.216,
  "end": 7.36,
  "text": "让 A 和 B 从同一个起点出发。"
 },
 {
  "start": 7.76,
  "end": 12.584,
  "text": "A 减 B，应该从哪个箭头的终点指向哪个终点？"
 },
 {
  "start": 13.234,
  "end": 14.842,
  "text": "先选。"
 },
 {
  "start": 15.242,
  "end": 22.346,
  "text": "因为 A 减 B 加上 B 等于 A，差矢量必须从 B 的终点指向 A 的终点。"
 },
 {
  "start": 22.746,
  "end": 26.01,
  "text": "方向反过来得到的是 B 减 A。"
 }
]
