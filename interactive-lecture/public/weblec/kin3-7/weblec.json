        "b": false
       },
       {
        "t": "完全非弹性碰撞",
        "size": 42,
        "color": "#C00000",
        "b": true
       },
       {
        "t": "，碰后一起运动，质量随飞行而增大：",
        "size": 42,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 1,
     "x": 500,
