     "h": 50,
     "align": "center",
     "valign": "center",
     "paras": [
      [
       {
        "t": "由 (1)：$mg=6\\pi\\eta rv_1$；由 (2)：$qE=mg-6\\pi\\eta rv_2$．",
        "size": 30,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 2,
     "x": 200,
     "y": 330,
     "w": 1520,
     "h": 110,
     "tex": "qE=6\\pi\\eta r(v_1-v_2)",
     "size": 34,
