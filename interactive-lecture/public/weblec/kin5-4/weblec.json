        "size": 32,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 4,
     "x": 170,
     "y": 540,
     "w": 780,
     "h": 120,
     "tex": "P+F_r=0",
     "size": 36,
     "color": "#C00000",
     "align": "left"
    },
    {
     "type": "tex",
