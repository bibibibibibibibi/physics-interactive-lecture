     "type": "text",
     "step": 1,
     "x": 170,
     "y": 240,
     "w": 1580,
     "h": 54,
     "align": "center",
     "valign": "center",
     "paras": [
      [
       {
        "t": "取",
        "size": 33,
        "color": "#111111",
        "b": false
       },
       {
        "t": "无穷远为势能零点",
        "size": 33,
        "color": "#C00000",
        "b": true
       },
       {
        "t": "：$r_B\\to\\infty$ ⇒ $1/r_B\\to0$．",
        "size": 32,
        "color": "#111111",
        "b": false
       }
      ]
