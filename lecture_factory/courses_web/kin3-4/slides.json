     "tex": "v=\\sqrt{2\\times9.8\\times1.0\\times(\\cos30^\\circ-\\cos60^\\circ)}=2.68\\ \\mathrm{m\\cdot s^{-1}}",
     "size": 42,
     "color": "#C00000",
