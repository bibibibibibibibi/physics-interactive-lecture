       {
        "t": "无限大均匀介质（$\\varepsilon_r$）中放自由电荷 $q_0$．",
        "size": 31,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 2,
     "x": 170,
