        "t": "充电规律",
        "size": 48,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 1,
     "x": 170,
     "y": 244,
     "w": 1580,
     "h": 140,
     "tex": "q=C\\\\varepsilon\\\\left(1-\\\\mathrm e^{-t/RC}\\\\right)",
     "size": 36,
     "color": "#C00000",
     "align": "center",
     "hotspot": true,
     "label": "充电电荷公式",
     "qa": [
