       {
        "t": "三　由功能关系得到伯努利方程",
        "size": 46,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 232,
     "w": 1580,
     "h": 56,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "功能关系：",
        "size": 36,
        "color": "#0000CD",
        "b": true
       },
       {
        "t": "W = E₂ − E₁",
        "size": 36,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 2,
     "x": 170,
     "y": 310,
     "w": 1580,
     "h": 140,
     "tex": "E_1=\\frac{\\Delta mv_1^2}{2}+\\Delta mgh_1,\\qquad E_2=\\frac{\\Delta mv_2^2}{2}+\\Delta mgh_2",
     "size": 32,
     "color": "#111111",
     "align": "left"
    },
    {
     "type": "text",
     "step": 3,
     "x": 170,
     "y": 470,
     "w": 1580,
     "h": 56,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "代入并两边除以 ΔV，用 ",
        "size": 34,
        "color": "#111111",
        "b": false
       },
       {
        "t": "ρ = Δm/ΔV",
        "size": 34,
        "color": "#0000CD",
        "b": true
       },
       {
        "t": "：",
        "size": 34,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 4,
     "x": 300,
     "y": 550,
     "w": 1320,
     "h": 150,
     "tex": "\\frac{\\rho v_1^2}{2}+\\rho gh_1+p_1=\\frac{\\rho v_2^2}{2}+\\rho gh_2+p_2",
     "size": 32,
     "color": "#C00000",
     "align": "center"
