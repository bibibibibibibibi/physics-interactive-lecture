     "x": 170,
     "y": 690,
     "w": 770,
     "h": 140,
     "tex": "C=\\dfrac{2\\pi\\varepsilon_0\\varepsilon_r l}{\\ln(R_2/R_1)}",
     "size": 30,
     "color": "#C00000",
     "align": "center"
    },
    {
