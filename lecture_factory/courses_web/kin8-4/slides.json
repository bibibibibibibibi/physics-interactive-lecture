     "y": 137,
     "w": 1580,
     "h": 90,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "二　自感磁能",
        "size": 50,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 236,
     "w": 1480,
     "h": 50,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "克服自感电动势的功率 $P=Li\\,\\mathrm di/\\mathrm dt$",
        "size": 31,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 2,
     "x": 170,
     "y": 306,
     "w": 1580,
     "h": 130,
     "tex": "W_m=\\int_0^{t}Li\\frac{\\mathrm di}{\\mathrm dt}\\mathrm dt=\\int_0^{I}Li\\,\\mathrm di",
     "size": 31,
     "color": "#111111",
     "align": "center",
     "hotspot": true,
     "label": "自感磁能积分推导",
     "qa": [
      {
       "q": "为什么积分上限从 t 变成 I？",
       "a": "用 $\\mathrm di=\\frac{\\mathrm di}{\\mathrm dt}\\mathrm dt$ 换元，时间积分化为对电流从 0 到 $I$ 的积分。"
      },
