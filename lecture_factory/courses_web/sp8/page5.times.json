[
 {
  "start": 0.0,
  "end": 3.262,
  "text": "先用已学的电磁波知识建立一个预言。"
 },
 {
  "start": 3.662,
  "end": 9.227,
  "text": "入射电场周期变化，会驱动电子振动，电子的加速运动又向外辐射。"
 },
 {
  "start": 9.627,
  "end": 16.231,
  "text": "在这里采用的经典线性、忽略反冲的模型中，受迫振动的频率跟随入射电场的频率。"
 },
 {
  "start": 16.631,
  "end": 22.094,
  "text": "观察方向能改变辐射强弱，却不会凭空产生一个随角度移动的新频率。"
 },
 {
  "start": 22.494,
  "end": 24.519,
  "text": "先想一个迁移问题。"
 },
 {
  "start": 24.919,
  "end": 30.864,
  "text": "现在用一束波长相同、强度加倍的光照射同一个样品，不改变测量角度。"
 },
 {
  "start": 31.264,
  "end": 35.107,
  "text": "仅仅提高入射强度，能解决位移峰的困难吗？"
 },
 {
  "start": 35.757,
  "end": 38.122,
  "text": "请完成选择，再继续。"
 },
 {
  "start": 38.522,
  "end": 41.764,
  "text": "实验发现的是一个可分辨的长波峰。"
 },
 {
  "start": 42.164,
  "end": 46.888,
  "text": "波长变长意味着频率降低，也意味着单个光子的能量减少。"
 },
 {
  "start": 47.288,
  "end": 52.031,
  "text": "经典同频再辐射的模型没有说明这部分能量转移到了哪里。"
 },
 {
  "start": 52.431,
  "end": 57.554,
  "text": "所以我们需要加入反冲和能量交换，不能只调整原有光谱的峰高。"
 },
 {
  "start": 57.954,
  "end": 59.98,
  "text": "还要注意模型的范围。"
 },
 {
  "start": 60.38,
  "end": 66.324,
  "text": "经典波动描述在许多情形依然有效，此处失败的是它对波长位移的这项预言。"
 }
]
