[
 {
  "start": 0.0,
  "end": 4.004,
  "text": "现在换一个情境，检验我们能不能独立判断。"
 },
 {
  "start": 4.404,
  "end": 10.052,
  "text": "回路固定，匀强磁场垂直纸面向里，但磁场大小均匀减小。"
 },
 {
  "start": 10.452,
  "end": 12.833,
  "text": "面积和方向都不变。"
 },
 {
  "start": 13.233,
  "end": 17.103,
  "text": "候选答案是顺时针、逆时针和零。"
 },
 {
  "start": 17.503,
  "end": 24.461,
  "text": "想一想，先独立选择，再说出理由：原磁通量怎样变化，感应磁场应当怎样？"
 },
 {
  "start": 25.661,
  "end": 27.331,
  "text": "一起核对。"
 },
 {
  "start": 27.731,
  "end": 34.979,
  "text": "向里的磁通量减少，感应场应向里，减缓这个减少，电流从纸面前方看就是顺时针。"
 },
 {
  "start": 35.379,
  "end": 44.138,
  "text": "如果选向外为法向，原磁通量为负；它向零靠近，导数为正，负号给出负电动势，也对应顺时针。"
 },
 {
  "start": 44.538,
  "end": 47.475,
  "text": "两条推理走到了同一个答案。"
 },
 {
  "start": 47.875,
  "end": 53.056,
  "text": "即使刚才选错了，也请找出具体错在哪一步，再沿着证据修正。"
 },
 {
  "start": 53.456,
  "end": 57.371,
  "text": "能够解释为什么，比一次猜对更重要。"
 }
]
