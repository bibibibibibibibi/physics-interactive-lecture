     "tex": "\\dfrac{W}{l}=\\dfrac{1}{2}\\dfrac{C}{l}U^{2}=\\dfrac{\\pi\\varepsilon_0\\varepsilon_r U^{2}}{\\ln(R_2/R_1)}",
     "size": 30,
     "color": "#C00000",
