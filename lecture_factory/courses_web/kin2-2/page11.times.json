[{"start": 0.0, "end": 2.02, "text": "我们来做一道题。"}, {"start": 2.42, "end": 11.42, "text": "已知等式 η 等于 F z 比 A u，其中 F 表示力，z 表示长度，A 表示面积，u 表示速度。"}, {"start": 11.82, "end": 13.86, "text": "求 η 的单位。"}, {"start": 14.26, "end": 17.6, "text": "给你四个选项，注意这是多选题。"}, {"start": 18.0, "end": 21.02, "text": "自己先算一算，再对答案。"}]