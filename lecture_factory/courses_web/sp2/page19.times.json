[
 {
  "start": 0.0,
  "end": 2.602,
  "text": "最后做一次条件变化的检验。"
 },
 {
  "start": 3.002,
  "end": 7.562,
  "text": "两线圈都固定，把发射端驱动改成恒定直流。"
 },
 {
  "start": 7.962,
  "end": 11.921,
  "text": "接通时电流从零上升，随后稳定。"
 },
 {
  "start": 12.321,
  "end": 15.523,
  "text": "请把“刚接通”和“稳定以后”分开。"
 },
 {
  "start": 15.923,
  "end": 20.659,
  "text": "稳定阶段，接收线圈还能持续得到感应电动势吗？"
 },
 {
  "start": 21.309,
  "end": 24.978,
  "text": "先选择，再用法拉第定律给出理由。"
 },
 {
  "start": 26.178,
  "end": 28.515,
  "text": "核对答案：不能。"
 },
 {
  "start": 28.915,
  "end": 38.852,
  "text": "开关过程中，电流、磁场和磁通量变化，可有暂态感应；稳定以后，几何条件不变，磁通量的时间导数为零。"
 },
 {
  "start": 39.252,
  "end": 45.588,
  "text": "若仍认为可以持续供能，就沿着能量链回查：持续变化的磁通量来自哪里？"
 },
 {
  "start": 46.238,
  "end": 51.018,
  "text": "能够明确适用条件，才能判断一种技术方案是否成立。"
 },
 {
  "start": 51.418,
  "end": 55.821,
  "text": "请点开助教热点，用自己的话说明这条链。"
 },
 {
  "start": 56.221,
  "end": 60.491,
  "text": "今天，我们要带走的是可以检验的推理方法。"
 }
]
