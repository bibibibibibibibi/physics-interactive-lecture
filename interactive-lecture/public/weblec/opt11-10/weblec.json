     "y": 660,
     "w": 1320,
     "h": 160,
     "tex": "\\theta+i_1+i_2-\\dfrac{\\pi}{2}=\\pi\\ \\Rightarrow\\ \\theta=i_1+i_2-90^{\\circ}",
