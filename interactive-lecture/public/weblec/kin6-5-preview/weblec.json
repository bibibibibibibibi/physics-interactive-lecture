    {
     "type": "tex",
     "step": 4,
     "x": 170,
     "y": 540,
     "w": 1580,
     "h": 140,
     "tex": "w=\\\\dfrac{W}{V}=\\\\dfrac{1}{2}\\\\varepsilon_0\\\\varepsilon_r E^{2}=\\\\dfrac{1}{2}\\\\vec E\\\\cdot\\\\vec D",
     "size": 32,
     "color": "#C00000",
     "align": "center",
     "hotspot": true,
     "label": "能量密度公式",
     "qa": [
      {
       "q": "能量密度 w 的定义是什么？",
       "a": "线性介质中 $w=\\frac12\\vec E\\cdot\\vec D$；各向同性时才化为 $w=\\frac12\\varepsilon E^2$。"
