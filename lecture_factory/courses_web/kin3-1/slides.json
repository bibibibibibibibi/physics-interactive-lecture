     "step": 1,
     "x": 170,
     "y": 250,
     "w": 1580,
     "h": 175,
     "tex": "\\int_{t_1}^{t_2}\\Big(\\sum_i\\vec F_i^{\\,\\mathrm{ex}}\\Big)\\mathrm{d}t=\\sum_i m_i\\vec v_i-\\sum_i m_i\\vec v_{i0}",
     "size": 40,
     "color": "#111111",
     "align": "center"
    },
