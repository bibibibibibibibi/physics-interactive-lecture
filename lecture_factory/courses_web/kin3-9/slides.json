        "t": "匀速上提 ⇒ ",
        "size": 40,
        "color": "#111111",
        "b": false
       },
       {
        "t": "dy/dt = v",
        "size": 40,
        "color": "#0000CD",
        "b": true
       },
       {
        "t": "，",
        "size": 40,
        "color": "#111111",
        "b": false
       },
       {
        "t": "d²y/dt² = 0",
        "size": 40,
        "color": "#0000CD",
        "b": true
       }
