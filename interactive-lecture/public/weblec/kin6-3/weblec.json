     "w": 1580,
     "h": 50,
     "align": "center",
     "valign": "center",
     "paras": [
      [
       {
        "t": "球对称：取半径 $r$ 的球面，$D$ 处处相等且垂直面．",
        "size": 30,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "tex",
     "step": 3,
     "x": 170,
     "y": 396,
     "w": 1580,
     "h": 130,
     "tex": "D\\cdot4\\pi r^{2}=q_0\\ \\Rightarrow\\ D=\\dfrac{q_0}{4\\pi r^{2}}",
     "size": 30,
     "color": "#C00000",
     "align": "center"
    },
    {
     "type": "tex",
     "step": 4,
     "x": 170,
     "y": 548,
     "w": 1580,
     "h": 130,
     "tex": "E=\\dfrac{D}{\\varepsilon_0\\varepsilon_r}=\\dfrac{q_0}{4\\pi\\varepsilon_0\\varepsilon_r r^{2}}",
     "size": 30,
     "color": "#C00000",
     "align": "center"
    },
