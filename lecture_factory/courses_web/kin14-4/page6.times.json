[{"start": 0.0, "end": 1.92, "text": "看第一个例子。"}, {"start": 2.32, "end": 9.06, "text": "光子火箭相对地球以 0.95c 飞行，火箭上的人量得自己长 15 米。"}, {"start": 9.46, "end": 12.27, "text": "问地面上的人量它多长。"}, {"start": 12.67, "end": 19.32, "text": "15 米是固有长度，代入公式：15 乘根号下一减 0.95 的平方。"}, {"start": 19.72, "end": 26.7, "text": "0.95 的平方是 0.9025，一减是 0.0975，开方是 0.312。"}, {"start": 27.1, "end": 31.35, "text": "乘 15，得 4.68 米——还不到三分之一。"}]