[
 {
  "start": 0.0,
  "end": 2.232,
  "text": "来做一道辨认题。"
 },
 {
  "start": 2.632,
  "end": 12.928,
  "text": "速度、速率、位移、路程、电场强度、温度、质量，这七个量里哪些必须同时给出大小和方向？"
 },
 {
  "start": 13.578,
  "end": 15.57,
  "text": "先自己选。"
 },
 {
  "start": 15.97,
  "end": 20.434,
  "text": "答案是速度、位移和电场强度。"
 },
 {
  "start": 20.834,
  "end": 27.482,
  "text": "速率与路程只说多少，不说朝向；温度、质量也没有空间方向。"
 },
 {
  "start": 27.882,
  "end": 32.418,
  "text": "尤其要把速度和速率分开，它们不是同一个量。"
 }
]
