[{"start": 0.0, "end": 3.02, "text": "把光程差代进干涉条件。"}, {"start": 3.42, "end": 5.29, "text": "先看明纹。"}, {"start": 5.69, "end": 9.41, "text": "2nd 加 λ/2 等于 kλ。"}, {"start": 9.81, "end": 14.23, "text": "解出 d 等于 2k 减 1 乘以 λ 除以 4n。"}, {"start": 14.63, "end": 16.5, "text": "再看暗纹。"}, {"start": 16.9, "end": 21.96, "text": "2nd 加 λ/2 等于 2k 加 1 乘以二分之 λ。"}, {"start": 22.36, "end": 25.82, "text": "解出 d 等于 kλ 除以 2n。"}, {"start": 26.22, "end": 32.51, "text": "棱边 d 等于零，光程差只剩 λ/2，所以棱边一定是暗纹。"}]