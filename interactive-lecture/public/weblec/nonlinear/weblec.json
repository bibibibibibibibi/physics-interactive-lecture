        "size": 48,
        "color": "#C00000",
        "b": true
       },
       {
        "t": "不满足叠加原理！",
        "size": 48,
        "color": "#0000CD",
        "b": true
       }
      ]
     ],
     "tex": null,
     "size": 40,
     "align": "center",
