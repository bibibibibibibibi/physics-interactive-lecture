     "w": 1580,
     "h": 170,
     "tex": "W=\\int_{\\theta_1}^{\\theta_2}M\\,\\mathrm d\\theta=\\int_{\\theta_1}^{\\theta_2}J\\frac{\\mathrm d\\omega}{\\mathrm dt}\\,\\mathrm d\\theta=\\int_{\\omega_1}^{\\omega_2}J\\omega\\,\\mathrm d\\omega",
     "size": 28,
     "color": "#111111",
     "align": "center"
    },
