        "t": "真空中两个静止点电荷之间的相互作用力：",
        "size": 38,
        "color": "#111111",
        "b": false
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 300,
     "w": 1580,
     "h": 56,
     "align": "left",
     "valign": "center",
     "paras": [
