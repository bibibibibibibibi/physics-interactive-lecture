[
 {
  "start": 0.0,
  "end": 3.203,
  "text": "开关改变了磁场的建立和消失。"
 },
 {
  "start": 3.603,
  "end": 7.095,
  "text": "如果一直通电，还能让检流计偏转吗？"
 },
 {
  "start": 7.745,
  "end": 13.681,
  "text": "左边演示中，插入、拔出线圈，改变相对位置，指针又动了。"
 },
 {
  "start": 14.081,
  "end": 18.663,
  "text": "可见，关键是穿过感应回路的磁场是否改变。"
 },
 {
  "start": 19.063,
  "end": 22.91,
  "text": "右边再试另一种操作：移动变阻器滑片。"
 },
 {
  "start": 23.31,
  "end": 31.402,
  "text": "请沿着因果链往下想：励磁回路电阻改变，励磁电流改变，磁场改变，感应回路才有响应。"
 },
 {
  "start": 31.802,
  "end": 35.25,
  "text": "这里有两种电阻，作用不能混淆。"
 },
 {
  "start": 35.65,
  "end": 41.298,
  "text": "励磁回路电阻影响磁场源；感应回路电阻影响感应电流。"
 },
 {
  "start": 41.698,
  "end": 50.48,
  "text": "在忽略自感和磁场反作用时，同样的磁通量变化给出相同电动势，感应回路电阻越大，电流越小。"
 },
 {
  "start": 50.88,
  "end": 54.772,
  "text": "现在我们找到了几种改变磁场的办法。"
 },
 {
  "start": 55.172,
  "end": 57.553,
  "text": "那磁场保持不变时呢？"
 }
]
