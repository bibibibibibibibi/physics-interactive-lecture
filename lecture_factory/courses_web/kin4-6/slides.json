     "x": 170,
     "y": 137,
     "w": 1580,
     "h": 90,
     "align": "left",
     "valign": "center",
     "paras": [
      [
       {
        "t": "三　讨论",
        "size": 50,
        "color": "#C00000",
        "b": true
       }
      ]
     ]
    },
    {
     "type": "text",
     "step": 1,
     "x": 170,
     "y": 240,
     "w": 1580,
     "h": 56,
     "align": "center",
     "valign": "center",
     "paras": [
      [
       {
        "t": "设质心到支点距离为 s，则 ",
        "size": 34,
        "color": "#111111",
        "b": false
       },
       {
