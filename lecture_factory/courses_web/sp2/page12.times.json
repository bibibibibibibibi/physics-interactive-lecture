[
 {
  "start": 0.0,
  "end": 2.887,
  "text": "把刚才的定向方法用起来。"
 },
 {
  "start": 3.287,
  "end": 7.421,
  "text": "两幅图中，磁铁的恩极都朝向线圈。"
 },
 {
  "start": 7.821,
  "end": 13.178,
  "text": "这次选法向向下，回路正向从上方看为顺时针。"
 },
 {
  "start": 13.578,
  "end": 18.796,
  "text": "左图，恩极靠近，原磁场向下，正磁通量增加。"
 },
 {
  "start": 19.196,
  "end": 24.184,
  "text": "负号给出负电动势，电流从上方看为逆时针。"
 },
 {
  "start": 24.584,
  "end": 30.541,
  "text": "它产生向上磁场，线圈上端相当于恩极，排斥靠近的磁铁。"
 },
 {
  "start": 30.941,
  "end": 33.805,
  "text": "再看右图，恩极远离。"
 },
 {
  "start": 34.205,
  "end": 38.177,
  "text": "原磁场仍向下，正磁通量却在减少。"
 },
 {
  "start": 38.577,
  "end": 44.373,
  "text": "电动势为正，电流从上方看为顺时针，产生向下磁场。"
 },
 {
  "start": 44.773,
  "end": 49.414,
  "text": "线圈上端相当于艾斯极，吸引远离的磁铁。"
 },
 {
  "start": 49.814,
  "end": 52.978,
  "text": "请停一下，把两图并排比较。"
 },
 {
  "start": 53.378,
  "end": 58.804,
  "text": "一个排斥，一个吸引；感应场一个向上，一个向下。"
 },
 {
  "start": 59.204,
  "end": 61.538,
  "text": "共同点究竟是什么？"
 },
 {
  "start": 62.188,
  "end": 65.052,
  "text": "它们都在阻碍原磁通量的变化。"
 },
 {
  "start": 65.452,
  "end": 69.356,
  "text": "靠近时阻碍增加，远离时减缓减少。"
 },
 {
  "start": 69.756,
  "end": 74.258,
  "text": "抓住“变化”这两个字，方向题就有了可靠的依据。"
 }
]
