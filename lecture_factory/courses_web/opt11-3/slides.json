     "type": "tex",
     "step": 2,
     "x": 300,
     "y": 330,
     "w": 1320,
     "h": 150,
     "tex": "\\Delta_r=2n_2d\\cos\\gamma+\\dfrac{\\lambda}{2}",
     "size": 42,
     "color": "#C00000",
