[{"start": 0.0, "end": 1.87, "text": "本节路线。"}, {"start": 2.27, "end": 7.91, "text": "先说原子核由什么组成、有多大，以及把核子绑住的核力。"}, {"start": 8.31, "end": 10.73, "text": "然后是自旋和磁矩。"}, {"start": 11.13, "end": 15.38, "text": "再讲结合能——这是理解裂变和聚变的关键。"}, {"start": 15.78, "end": 18.59, "text": "接着是放射性衰变的规律。"}, {"start": 18.99, "end": 23.41, "text": "最后是裂变、聚变，以及辐射剂量的防护。"}]